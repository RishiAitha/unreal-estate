int main() {
    initialize();

    while (1) {
        oldButtons = buttons;
        buttons = (*(volatile unsigned short *)0x04000130);

        if (!current_state.initialized && current_state.initState) {
            current_state.initState();
            current_state.initialized = 1;
        }
        current_state.doState();
    }
}

